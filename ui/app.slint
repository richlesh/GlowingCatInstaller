import { ComboBox, ScrollView, Button } from "std-widgets.slint";

// Per-project data pushed from Rust. Field names must match the Rust struct
// generated by slint-build.
export struct ProjectCard {
    id: int,
    name: string,
    description: string,
    icon: image,
    action: string,   // Button label: Install / Upgrade / Remove / status
    status: string,    // Secondary line: version info or error
    kind: string,      // "install" | "upgrade" | "remove" | "busy" | "none"
    disabled: bool,
}

// Theme palette, switchable between dark and light. `dark` is driven from Rust
// via MainWindow.dark-mode.
export global Theme {
    in property <bool> dark: true;

    out property <color> bg: dark ? #1b1d23 : #f4f5f7;
    out property <color> panel: dark ? #262932 : #ffffff;
    out property <color> panel-border: dark ? #343845 : #e2e4e9;
    out property <color> text: dark ? #e8eaf0 : #1b1d23;
    out property <color> text-dim: dark ? #9aa0ad : #6b7280;
    out property <color> accent: #7c5cff;
    out property <color> install: #2e9e5b;
    out property <color> upgrade: #2d7ff9;
    out property <color> remove: #d2503b;

    // Dialog surfaces (About): card, overlay scrim, and link colors.
    out property <color> card-bg: dark ? #262932 : #ffffff;
    out property <color> scrim: dark ? #000000c0 : #00000060;
    out property <color> link: dark ? #5c9dff : #0a58ca;
    out property <color> link-hover: dark ? #7fb0ff : #3b7dd8;
}

// A clickable text link. Emits `open-url` with the URL to open.
component Hyperlink inherits TouchArea {
    in property <string> text;
    in property <string> url;
    callback open-url(string);
    mouse-cursor: pointer;
    Text {
        text: root.text;
        color: root.has-hover ? Theme.link-hover : Theme.link;
        horizontal-alignment: center;
    }
    clicked => { root.open-url(root.url); }
}

// A full-window dark scrim with centered @children. `dismiss` fires when the
// scrim (outside the card) is clicked.
component DialogScrim inherits Rectangle {
    callback dismiss();
    background: Theme.scrim;
    // Catch clicks on the scrim so they don't fall through to the window.
    TouchArea {
        clicked => { root.dismiss(); }
    }
    @children
}

component IconToggle inherits Rectangle {
    callback clicked();
    in property <string> glyph;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: ta.has-hover ? Theme.panel-border : Theme.panel;
    border-width: 1px;
    border-color: Theme.panel-border;
    animate background { duration: 120ms; }
    Text {
        text: root.glyph;
        font-size: 18px;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Card inherits Rectangle {
    in property <ProjectCard> data;
    // When Alt/Option is held, an "upgrade" card presents as "Remove".
    in property <bool> alt-held;
    callback action-pressed(int);

    // Effective kind after applying the Alt/Option modifier.
    property <string> eff-kind: (root.data.kind == "upgrade" && root.alt-held)
        ? "remove" : root.data.kind;
    property <string> eff-action: (root.data.kind == "upgrade" && root.alt-held)
        ? "Remove" : root.data.action;

    background: Theme.panel;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.panel-border;

    // Button geometry, pinned to the bottom of the card so it never moves
    // when the status label changes height.
    property <length> pad: 16px;
    property <length> btn-h: 34px;
    // Clear gap between the (bottom-aligned) status label and the button, so
    // even a two/three-line status sits a line above the button instead of
    // running into it.
    property <length> status-gap: 20px;

    // Upper content (icon, name, description, status). This block fills the
    // card down to just above the fixed button. The status is bottom-aligned
    // within this block, so a long (up to three-line) status grows upward
    // toward the description instead of pushing the button down.
    VerticalLayout {
        x: root.pad;
        y: root.pad;
        width: root.width - 2 * root.pad;
        height: root.height - 2 * root.pad - root.btn-h - root.status-gap;
        spacing: 8px;
        alignment: start;

        Rectangle {
            height: 72px;
            Image {
                source: root.data.icon;
                width: 72px;
                height: 72px;
                image-fit: contain;
            }
        }

        Text {
            text: root.data.name;
            font-size: 15px;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            text: root.data.description;
            font-size: 11px;
            color: Theme.text-dim;
            horizontal-alignment: center;
            wrap: word-wrap;
            height: 46px;
            overflow: elide;
        }
    }

    // Status label, absolutely positioned so its bottom edge sits a fixed gap
    // above the button. Because `y` is derived from the label's own height,
    // extra lines grow the label *upward* (toward the description) and the
    // button never moves.
    status := Text {
        text: root.data.status;
        x: root.pad;
        width: root.width - 2 * root.pad;
        y: root.height - root.pad - root.btn-h - root.status-gap - self.height;
        font-size: 10px;
        color: Theme.text-dim;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    // Fixed button, anchored to the bottom of the card.
    Rectangle {
        x: root.pad;
        y: root.height - root.pad - root.btn-h;
        width: root.width - 2 * root.pad;
        height: root.btn-h;
        border-radius: 8px;
        background: root.data.disabled ? Theme.panel-border
            : root.eff-kind == "install" ? Theme.install
            : root.eff-kind == "upgrade" ? Theme.upgrade
            : root.eff-kind == "remove" ? Theme.remove
            : Theme.panel-border;
        opacity: root.data.disabled ? 0.6 : 1.0;

        Text {
            text: root.eff-action;
            color: white;
            font-size: 13px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            enabled: !root.data.disabled;
            clicked => { root.action-pressed(root.data.id); }
        }
    }
}

export component MainWindow inherits Window {
    title: "Glowing Cat Software Installer";
    preferred-width: 980px;
    preferred-height: 720px;
    min-width: 520px;
    min-height: 480px;
    background: Theme.bg;

    // Application / window icon (resources/icons/app_icon.png, set from Rust).
    in property <image> app-icon;
    icon: root.app-icon;

    // --- Inputs from Rust ---
    in property <[ProjectCard]> projects;
    in property <[string]> os-options;
    in property <int> os-index;
    in property <string> arch-label;
    // Install scope ("Install for:"): options and current selection.
    in property <[string]> scope-options;
    in property <int> scope-index;
    in-out property <bool> dark-mode: true;
    in property <string> global-status;
    // True while Alt/Option is held; flips Upgrade cards to Remove.
    in-out property <bool> alt-held: false;
    // Self-install state: whether this app is installed on the machine, and a
    // hint describing where it would be / is installed.
    in property <bool> self-installed: false;
    in property <string> self-install-hint;
    // Self-update: whether a newer release of this installer is available, and
    // the version string to show on the "Update available" control.
    in property <bool> self-update-available: false;
    in property <string> self-update-version;

    // About dialog state.
    in property <string> app-version;
    in property <bool> show-about: false;

    // True on platforms that use the Slint declarative menu bar (Windows and
    // Linux). On macOS the menu bar is built natively with muda from Rust (see
    // menu_macos.rs) so the real Application menu's About item is used; this is
    // left false there to avoid a second, app-named menu.
    in property <bool> use-slint-menubar: false;

    // --- Outputs to Rust ---
    callback os-changed(int);
    callback theme-toggled(bool);
    // Install-scope popup changed ("All Users" / "This User").
    callback scope-changed(int);    callback action-pressed(int);
    callback refresh();
    // Fired when alt-held changes, so Rust can mirror the modifier state.
    callback alt-changed(bool);
    // Install or uninstall this application itself.
    callback self-install-pressed();
    callback self-uninstall-pressed();
    // Download and run the newer installer for this app.
    callback self-update-pressed();
    // About dialog: open it (from the menu), confirm/close it, and open a URL
    // in the system browser.
    callback open-about();
    callback about-ok();
    callback open-url(string);

    forward-focus: focus-scope;

    // Drive the Theme global from the window property. Set at init and whenever
    // dark-mode changes.
    init => { Theme.dark = root.dark-mode; }
    changed dark-mode => { Theme.dark = root.dark-mode; }

    // Card geometry constants (shared by the grid math).
    property <length> card-w: 220px;
    property <length> card-h: 240px;
    property <length> gap: 16px;

    // Menu bar. Only built on Windows/Linux (guarded by use-slint-menubar); on
    // macOS the native muda menu is created in Rust (see menu_macos.rs), so the
    // About item lives in the real Application menu. There is no OS
    // "Application menu" on Windows/Linux, so About lives in a leading
    // app-named menu here.
    if root.use-slint-menubar: MenuBar {
        Menu {
            title: "Glowing Cat Installer";
            MenuItem {
                title: "About Glowing Cat Installer";
                activated => { root.open-about(); }
            }
        }
    }

    VerticalLayout {
        // Keyboard handling for the Alt/Option modifier. A FocusScope receives
        // key events; we toggle `alt-held` on Alt down/up. Slint maps the key
        // via KeyEvent.modifiers.alt which is set on all key events while the
        // modifier is held, so we also inspect modifiers on every key event.
        focus-scope := FocusScope {
            // Zero-height: it only exists to capture key events.
            height: 0px;
            key-pressed(event) => {
                if (event.modifiers.alt || event.text == Key.Alt) {
                    if (!root.alt-held) {
                        root.alt-held = true;
                        root.alt-changed(true);
                    }
                }
                accept
            }
            key-released(event) => {
                // When Alt is released, modifiers.alt becomes false.
                if (event.text == Key.Alt || !event.modifiers.alt) {
                    if (root.alt-held) {
                        root.alt-held = false;
                        root.alt-changed(false);
                    }
                }
                accept
            }
        }

        // Top bar.
        Rectangle {
            height: 64px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.panel-border;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                alignment: space-between;

                // Left: OS popup + arch label.
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        ComboBox {
                            width: 190px;
                            model: root.os-options;
                            current-index: root.os-index;
                            selected(value) => {
                                root.os-changed(self.current-index);
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Arch: " + root.arch-label;
                            color: Theme.text-dim;
                            font-size: 12px;
                        }
                    }
                    // Install scope selector.
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Install for:";
                            color: Theme.text-dim;
                            font-size: 12px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        ComboBox {
                            width: 130px;
                            model: root.scope-options;
                            current-index: root.scope-index;
                            selected(value) => {
                                root.scope-changed(self.current-index);
                            }
                        }
                    }
                }

                // Center: (title removed to reduce top-bar crowding).

                // Right: self-install + refresh + theme toggle.
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    // Self-update pill: shown only when a newer release of this
                    // app is available. Clicking it downloads and runs the new
                    // installer.
                    if root.self-update-available: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 30px;
                            width: update-txt.preferred-width + 24px;
                            border-radius: 15px;
                            border-width: 1px;
                            border-color: Theme.upgrade;
                            background: update-ta.has-hover ? Theme.upgrade : Theme.panel;
                            animate background { duration: 120ms; }
                            update-txt := Text {
                                text: "Update available → " + root.self-update-version;
                                color: update-ta.has-hover ? white : Theme.upgrade;
                                font-size: 12px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            update-ta := TouchArea {
                                clicked => { root.self-update-pressed(); }
                            }
                        }
                    }

                    // Self-install / uninstall pill. Label reflects state.
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 30px;
                            width: self-txt.preferred-width + 24px;
                            border-radius: 15px;
                            border-width: 1px;
                            border-color: Theme.panel-border;
                            background: self-ta.has-hover
                                ? (root.self-installed ? Theme.remove : Theme.install)
                                : Theme.panel;
                            animate background { duration: 120ms; }
                            self-txt := Text {
                                text: root.self-installed ? "Uninstall this app" : "Install this app";
                                color: self-ta.has-hover ? white : Theme.text;
                                font-size: 12px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            self-ta := TouchArea {
                                clicked => {
                                    if (root.self-installed) {
                                        root.self-uninstall-pressed();
                                    } else {
                                        root.self-install-pressed();
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        IconToggle {
                            glyph: "\u{21bb}";
                            clicked => { root.refresh(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconToggle {
                            // Show the current theme: a moon in dark mode, a sun
                            // in light mode. Use ☾ (U+263E LAST QUARTER MOON) from
                            // the same Miscellaneous Symbols block as the sun — the
                            // thin ☽ (U+263D) lacks coverage in the bundled font and
                            // rendered as a tofu box.
                            glyph: root.dark-mode ? "\u{263E}" : "\u{2600}";
                            clicked => {
                                root.dark-mode = !root.dark-mode;
                                root.theme-toggled(root.dark-mode);
                            }
                        }
                    }
                }
            }
        }

        // Optional global status line.
        if root.global-status != "": Rectangle {
            height: 28px;
            background: Theme.bg;
            Text {
                text: root.global-status;
                color: Theme.text-dim;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Project grid in a scroll view.
        ScrollView {
            VerticalLayout {
                padding: 16px;

                grid := Rectangle {
                    // Columns that fit in the available width.
                    property <int> cols: max(1, floor((grid.width + root.gap) / (root.card-w + root.gap)));
                    property <int> count: root.projects.length;
                    property <int> rows: ceil(count / cols);
                    height: rows * (root.card-h + root.gap);

                    for card[i] in root.projects: Card {
                        data: card;
                        alt-held: root.alt-held;
                        width: root.card-w;
                        height: root.card-h;
                        x: mod(i, grid.cols) * (root.card-w + root.gap);
                        y: floor(i / grid.cols) * (root.card-h + root.gap);
                        action-pressed(id) => { root.action-pressed(id); }
                    }
                }
            }
        }
    }

    // ---- About dialog ---------------------------------------------------
    // Modal overlay: a dark scrim with a centered card showing the app icon,
    // name, version, copyright, "Built with Slint", and links. Clicking the
    // scrim or OK closes it.
    if root.show-about: DialogScrim {
        dismiss => { root.about-ok(); }
        Rectangle {
            width: 300px;
            height: about-col.preferred-height + 32px;
            background: Theme.card-bg;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.panel-border;
            about-col := VerticalLayout {
                alignment: center;
                spacing: 6px;
                padding: 16px;
                HorizontalLayout {
                    alignment: center;
                    Image { source: root.app-icon; width: 96px; height: 96px; }
                }
                Text {
                    text: "Glowing Cat Software Installer";
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.text;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: "Version " + root.app-version;
                    color: Theme.text-dim;
                    horizontal-alignment: center;
                }
                Text {
                    text: "©2026 Richard Lesh";
                    color: Theme.text-dim;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Built with Rust and Slint";
                    color: Theme.text-dim;
                    horizontal-alignment: center;
                }
                Hyperlink {
                    text: "Glowing Cat Software";
                    url: "https://glowingcat.com/";
                    open-url(u) => { root.open-url(u); }
                }
                HorizontalLayout {
                    alignment: center;
                    Button { text: "OK"; min-width: 90px; clicked => { root.about-ok(); } }
                }
            }
        }
    }
}
